# --- Base de données ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bonnes_tables?schema=public"

# --- Authentification (NextAuth / Auth.js) ---
# Générer avec : npx auth secret   (ou : openssl rand -base64 32)
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Site public ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="19 Bonnes Tables Sarthoises"

# --- Emails (Resend) — notifications de contact + newsletter ---
# SMTP direct ne fonctionne pas depuis Railway (ports sortants bloqués) :
# on passe par l'API HTTP de Resend (https://resend.com). Domaine à vérifier
# côté Resend (enregistrements DNS chez IONOS) avant le premier envoi.
RESEND_API_KEY=""
MAIL_FROM="19 Bonnes Tables Sarthoises <contact@19bonnes-tables-sarthoises.fr>"
CONTACT_NOTIFICATION_EMAIL="contact@19bonnes-tables-sarthoises.fr"

# --- Stockage médias ---
# "local" écrit dans /storage/uploads (volume Docker en prod).
# "s3" utilise un stockage compatible S3 (voir lib/storage/s3.ts) — remplir les
# variables ci-dessous uniquement si STORAGE_DRIVER=s3.
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage/uploads"
NEXT_PUBLIC_MEDIA_BASE_URL="http://localhost:3000/media"

S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# --- reCAPTCHA (formulaire de contact) ---
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# --- Mesure d'audience (Umami, auto-hébergé) ---
# Laisser vide pour désactiver totalement le suivi (aucun script chargé).
# Script chargé uniquement après consentement — voir lib/analytics.ts.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# --- Paiement (Stripe) — achat de bons cadeaux en ligne ---
# Clé secrète du compte Stripe (mode test ou live selon l'environnement) et
# secret de signature du webhook (Stripe Dashboard > Developers > Webhooks,
# endpoint /api/webhooks/stripe, événement "checkout.session.completed").
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Compte super-admin initial (utilisé par prisma/seed.ts) ---
SEED_ADMIN_EMAIL="admin@19bonnes-tables-sarthoises.fr"
SEED_ADMIN_PASSWORD="changeme-au-premier-lancement"
