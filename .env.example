# --- Base de données ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bonnes_tables?schema=public"

# --- Authentification (NextAuth / Auth.js) ---
# Générer avec : npx auth secret   (ou : openssl rand -base64 32)
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Site public ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="19 Bonnes Tables Sarthoises"

# --- Emails (SMTP) — notifications de contact + emails admin ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="19 Bonnes Tables Sarthoises <contact@19bonnestablessarthoises.fr>"
CONTACT_NOTIFICATION_EMAIL="contact@19bonnestablessarthoises.fr"

# --- Stockage médias ---
# "local" écrit dans /storage/uploads (volume Docker en prod).
# "s3" utilise un stockage compatible S3 (voir lib/storage/s3.ts) — remplir les
# variables ci-dessous uniquement si STORAGE_DRIVER=s3.
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage/uploads"
NEXT_PUBLIC_MEDIA_BASE_URL="http://localhost:3000/media"

S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# --- reCAPTCHA (formulaire de contact) ---
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# --- Mesure d'audience (Umami, auto-hébergé) ---
# Laisser vide pour désactiver totalement le suivi (aucun script chargé).
# Script chargé uniquement après consentement — voir lib/analytics.ts.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# --- Compte super-admin initial (utilisé par prisma/seed.ts) ---
SEED_ADMIN_EMAIL="admin@19bonnestablessarthoises.fr"
SEED_ADMIN_PASSWORD="changeme-au-premier-lancement"
